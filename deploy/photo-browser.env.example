# Copy this file to /etc/photo-browser/photo-browser.env and replace the
# secret key before enabling the systemd unit.
PHOTO_ARCHIVE_BASE_URL=http://poirot:4242
PHOTO_BROWSER_HOST=0.0.0.0
PHOTO_BROWSER_PORT=8090
PHOTO_BROWSER_REQUEST_TIMEOUT_SECONDS=15
PHOTO_BROWSER_BROWSE_PAGE_SIZE=24
PHOTO_BROWSER_SEARCH_PAGE_SIZE=40
PHOTO_BROWSER_INDEX_TTL_SECONDS=3600
PHOTO_BROWSER_MAX_INDEX_ENTRIES=5000
PHOTO_BROWSER_SECRET_KEY=replace-with-a-random-secret
